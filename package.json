{
  "name": "privatetutor",
  "version": "1.0.0",
  "private": true,
  "description": "Location-based private tutor marketplace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=apps/server",
    "dev:client": "npm run dev --workspace=apps/client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm run build --workspace=apps/server",
    "build:client": "npm run build --workspace=apps/client",
    "seed": "npm run seed --workspace=apps/server",
    "test": "npm test --workspace=apps/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
